      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Ablation: FC classique (~30 sec)...\n",
            "FC seuil=0.5 : Acc=69.0% Rec=78.3% F1=56.9% AUC=0.803\n",
            "FC Youden(0.541): Acc=71.7% Rec=75.1% F1=58.1%\n",
            "[13:58:35] Sauvegardé : fc\n",
