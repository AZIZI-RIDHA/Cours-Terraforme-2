        "def mcnemar(yt, pa, pb):\n",
        "    b = np.sum((pa==yt) & (pb!=yt))\n",
        "    c = np.sum((pa!=yt) & (pb==yt))\n",
        "    if b+c == 0: return 0.0, 1.0\n",
        "    chi = (abs(b-c)-1)**2 / (b+c)\n",
        "    return chi, 1 - chi2_dist.cdf(chi, df=1)\n",
