          ]
        }
      ],
      "source": [
        "print('Ablation: FC classique (~30 sec)...')\n",
        "\n",
        "class ClassicalFC(nn.Module):\n",
        "    def __init__(self, inp=8, hid=72):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(inp, hid), nn.Tanh(),\n",
        "            nn.Linear(hid, 1),  nn.Sigmoid())\n",
        "    def forward(self, x): return self.net(x)\n",
        "\n",
        "def train_fc(Xtr, ytr, Xvl, yvl, ep=150, lr=1e-3):\n",
        "    m   = ClassicalFC(Xtr.shape[1])\n",
        "    opt = optim.Adam(m.parameters(), lr=lr)\n",
        "    cr  = nn.BCELoss()\n",
        "    Xt  = torch.FloatTensor(Xtr); yt = torch.FloatTensor(ytr).unsqueeze(1)\n",
        "    Xv  = torch.FloatTensor(Xvl); yv = torch.FloatTensor(yvl).unsqueeze(1)\n",
        "    bv, pat, bs = float('inf'), 0, None\n",
        "    for e in range(ep):\n",
        "        m.train()\n",
        "        loss = cr(m(Xt), yt)\n",
        "        opt.zero_grad(); loss.backward(); opt.step()\n",
        "        m.eval()\n",
        "        with torch.no_grad():\n",
        "            vl = cr(m(Xv), yv).item()\n",
        "        if vl < bv:\n",
        "            bv  = vl; pat = 0\n",
        "            bs  = {k: v.clone() for k, v in m.state_dict().items()}\n",
        "        else:\n",
        "            pat += 1\n",
        "        if pat >= 20: break\n",
        "    m.load_state_dict(bs)\n",
        "    return m\n",
        "\n",
        "Xtr, Xvl, ytr, yvl = train_test_split(\n",
        "    X_train_8n, y_train,\n",
        "    test_size=0.2, stratify=y_train, random_state=SEED)\n",
        "\n",
        "fc_model = train_fc(Xtr, ytr, Xvl, yvl)\n",
        "fc_model.eval()\n",
        "with torch.no_grad():\n",
        "    fc_probs = fc_model(torch.FloatTensor(X_test_8n)).numpy().flatten()\n",
        "\n",
        "fpr_fc, tpr_fc, thr_fc = roc_curve(y_test, fc_probs)\n",
        "opt_thr_fc = float(thr_fc[np.argmax(tpr_fc - fpr_fc)])\n",
        "fc_p05     = (fc_probs > 0.5).astype(int)\n",
        "fc_popt    = (fc_probs > opt_thr_fc).astype(int)\n",
        "\n",
        "FC = {\n",
        "    'acc05'  : accuracy_score(y_test, fc_p05) * 100,\n",
        "    'rec05'  : recall_score(y_test, fc_p05, zero_division=0) * 100,\n",
        "    'f105'   : f1_score(y_test, fc_p05, zero_division=0) * 100,\n",
        "    'prec05' : precision_score(y_test, fc_p05, zero_division=0) * 100,\n",
        "    'auc'    : roc_auc_score(y_test, fc_probs),\n",
        "    'acc_opt': accuracy_score(y_test, fc_popt) * 100,\n",
        "    'rec_opt': recall_score(y_test, fc_popt, zero_division=0) * 100,\n",
        "    'f1_opt' : f1_score(y_test, fc_popt, zero_division=0) * 100,\n",
        "    'thresh' : opt_thr_fc,\n",
        "}\n",
        "\n",
        "print(f'FC seuil=0.5 : Acc={FC[\"acc05\"]:.1f}% Rec={FC[\"rec05\"]:.1f}% '\n",
        "      f'F1={FC[\"f105\"]:.1f}% AUC={FC[\"auc\"]:.3f}')\n",
        "print(f'FC Youden({opt_thr_fc:.3f}): Acc={FC[\"acc_opt\"]:.1f}% '\n",
        "      f'Rec={FC[\"rec_opt\"]:.1f}% F1={FC[\"f1_opt\"]:.1f}%')\n",
        "autosave('fc', fc_probs=fc_probs, y_test=y_test)\n",
        "print('OK')\n"
      ]
